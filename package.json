{
  "name": "dungeon-schemer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "backtest:quick": "B1_SOURCE_REVISION=$(git rev-parse --short HEAD) B1_BACKTEST_MODE=calibration vitest run --config vitest.backtest.config.ts",
    "backtest": "B1_SOURCE_REVISION=$(git rev-parse --short HEAD) B1_BACKTEST_MODE=holdout vitest run --config vitest.backtest.config.ts"
  },
  "dependencies": {
    "framer-motion": "^13.1.1",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "24.19.0"
  },
  "packageManager": "pnpm@11.21.0"
}
